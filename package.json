{
  "name": "taskmaster",
  "version": "1.0.0",
  "description": "AI-powered task breakdown application",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder",
    "build-linux": "electron-builder --linux",
    "build-windows": "electron-builder --windows",
    "build-mac": "electron-builder --mac",
    "pack": "electron-builder --dir",
    "postinstall": "electron-builder install-app-deps"
  },
  "keywords": [
    "task",
    "breakdown",
    "productivity",
    "ai",
    "gemini",
    "electron",
    "taskmaster"
  ],
  "author": "Your Name",
  "license": "MIT",
  "devDependencies": {
    "electron": "^27.0.0",
    "electron-builder": "^24.6.4"
  },
  "build": {
    "appId": "com.taskmaster.app",
    "productName": "TaskMaster",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "task_breakdown.py",
      ".env",
      "task_breakdown_env/**/*",
      "!node_modules/**/*"
    ],
    "linux": {
      "target": ["AppImage", "deb"],
      "category": "Utility"
    },
    "win": {
      "target": ["nsis"]
    },
    "mac": {
      "target": ["dmg"]
    }
  }
}